{
  "name": "nowhere-common",
  "version": "1.0.0",
  "private": true,
  "description": "Common library for Nowhere's Microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.lib.tsbuildinfo && tsc -p tsconfig.lib.json"
  },
  "author": "Ali Hasan",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1116.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "contracts": "workspace:*",
    "helmet": "^8.1.0",
    "nats": "^2.29.3",
    "mongoose": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "packageManager": "pnpm@10.15.1"
}
