{
  "name": "contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared contracts and schemas for Nowhere microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.lib.tsbuildinfo && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
