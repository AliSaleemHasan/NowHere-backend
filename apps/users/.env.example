NEST_PORT=3001

# MYSQL DATABASE FOR USERS
MYSQL_PORT=3306
MYSQL_DATABASE=Users_Info
MYSQL_ROOT_PASS=change_me_mysql_root_pass
MYSQL_USER=info_admin
MYSQL_PASS=change_me_mysql_pass
MYSQL_HOST=mysql

# JWT Environment variables
ACCESS_SECRET=change_me_jwt_access_secret
REFRESH_SECRET=change_me_jwt_refresh_secret
ACCESS_EXP=1d
REFRESH_EXP=7d

# ADMIN SEED CREDENTIALS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# GCP Secret Manager (Optional for local, required for prod)
# GCP_PROJECT_ID=your-gcp-project-id
