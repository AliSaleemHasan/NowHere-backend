# NEST DEVELOPMENT ENVIRONMENTS VARIABLES
NEST_PORT=3000

# MONGODB ENVIRONMENT VARIABLES
MONGO_PORT=27017
MONGO_DATABASE=nowhere
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=change_me_mongo_root_pass
MONGO_HOST=mongodb
MONGO_EXPRESS_PORT=8081

# Application Settings
MAX_DISTANCE_NEAR=5000
MIN_DISTANCE_SAME_USER=500

# JWT Environment variables
ACCESS_SECRET=change_me_jwt_access_secret

# Static Env files Configuration
STATIC_TMP_FILES=change_me_tmp_files_prefix
INTERNAL_API_SECRET=change_me_internal_api_secret

# Gateway (Socket IO) Configuration
GATEWAY_URL=http://localhost:3000

# GCP Secret Manager (Optional for local, required for prod)
# GCP_PROJECT_ID=your-gcp-project-id
