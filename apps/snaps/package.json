{
  "name": "snaps",
  "version": "1.0.0",
  "main": "dist/apps/snaps/src/main.js",
  "scripts": {
    "start": "ts-node-dev -r tsconfig-paths/register --ignore-watch  --respawn src/main.ts",
    "start:prod": "node ../../dist/apps/snaps/apps/snaps/src/main.js",
    "build": "tsc -p tsconfig.app.json",
    "test": "nx jest:test",
    "test:watch": "nx jest:test --watch",
    "test:cov": "nx jest:test --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.873.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/schedule": "^6.1.3",
    "contracts": "workspace:*",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.18.1",
    "nowhere-common": "workspace:*",
    "socket.io": "^4.8.1"
  },
  "author": "Ali Hasan",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1"
}
