{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^nowhere-common(|/.*)$": "<rootDir>/../../../libs/nowhere-common/src/$1",
    "^contracts(|/.*)$": "<rootDir>/../../../libs/contracts/src/$1"
  }
}
