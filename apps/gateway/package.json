{
  "name": "gateway",
  "version": "1.0.0",
  "main": "dist/apps/gateway/src/index.js",
  "private": true,
  "scripts": {
    "start": "ts-node-dev -r tsconfig-paths/register --ignore-watch  --respawn src/main.ts",
    "start:prod": "node ../../dist/apps/gateway/apps/gateway/src/main.js",
    "build": "tsc -p tsconfig.app.json",
    "test": "nx jest:test",
    "test:watch": "nx jest:test --watch",
    "test:cov": "nx jest:test --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "bcrypt": "^6.0.0",
    "contracts": "workspace:*",
    "multer": "^2.0.2",
    "mysql2": "^3.14.2",
    "nowhere-common": "workspace:*",
    "typeorm": "^0.3.26"
  },
