# NEST DEVELOPMENT ENVIRONMENTS VARIABLES
NEST_PORT=3002

# JWT Environment variables
ACCESS_SECRET=change_me_jwt_access_secret

# Snaps TMP images
STATIC_TMP_FILES=change_me_tmp_files_prefix
SNAPS_URL=http://nest-dev:3000
INTERNAL_API_SECRET=change_me_internal_api_secret

# Redis connection
REDIS_URL=redis://redis:6379
CACHE_TTL=86340

# MinIO / AWS S3 connection
AWS_BUCKET=mysnapsbucket
AWS_ACCESS_KEY_ID=change_me_access_key_id
AWS_SECRET_ACCESS_KEY=change_me_secret_access_key
AWS_ENDPOINT_URL=http://minio-local:9000
AWS_REGION=us-east-1

# GCP Secret Manager (Optional for local, required for prod)
# GCP_PROJECT_ID=your-gcp-project-id
